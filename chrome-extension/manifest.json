{
  "manifest_version": 3,
  "name": "OpenCore Browser Control",
  "version": "0.1.3",
  "description": "Pair Chrome tabs with OpenCore.",
  "minimum_chrome_version": "116",
  "permissions": [
    "debugger",
    "tabs",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1/pair"
      ],
      "js": [
        "pair.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "OpenCore Browser",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/opencore-32.png",
      "32": "icons/opencore-32.png"
    }
  },
  "icons": {
    "16": "icons/opencore-32.png",
    "32": "icons/opencore-32.png",
    "48": "icons/opencore-128.png",
    "128": "icons/opencore-128.png"
  }
}
